{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.ai.app",
  "productName": "ai",
  "version": "0.1.0",

  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },

