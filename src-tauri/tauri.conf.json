{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.phoenix.ai",
  "productName": "Phoenix AI",
  "version": "0.1.0",

  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },

  "app": {
    "windows": [
      {
        "title": "Phoenix AI",
        "width": 1100,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "devtools": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "resources": ["icons"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Phoenix AI",
    "copyright": "Copyright © 2026 Phoenix AI",
    "category": "Productivity",
    "shortDescription": "Offline AI assistant powered by local models.",
    "longDescription": "Phoenix AI is a modern offline AI assistant with local model support, chat history, Phoenix Messenger, and a futuristic desktop experience.",

    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "displayLanguageSelector": false
      }
    }
  }
}